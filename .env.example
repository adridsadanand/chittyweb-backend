# Copy this file to .env and fill in your own values. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/chittybook?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-long-random-string
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Optional — enables email-based passcode recovery for admins who add a
# recovery email. Without these, that feature just prints the code to
# this console instead (fine for local testing).
# Generate an app password at myaccount.google.com/apppasswords
# (requires 2-Step Verification on that Google account first).
GMAIL_USER=
GMAIL_APP_PASSWORD=
